{
  "name": "crm-chat-convex-backend",
  "private": true,
  "type": "module",
  "exports": {
    "./convex/_generated/api": "./convex/_generated/api.js",
    "./convex/_generated/dataModel": "./convex/_generated/dataModel.d.ts",
    "./convex/*": "./convex/*"
  },
  "scripts": {
    "dev": "secretspec run --profile convex_backend -- bun -b convex dev",
    "deploy": "secretspec run --profile convex_backend -- convex deploy",
    "typecheck": "tsc -b",
    "lint": "eslint convex/ && biome check && tsc -b",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "postinstall": "if [ -z \"$NIX_BUILD_TOP\" ]; then bun2nix -o bun.nix && nix fmt .; fi"
  },
  "dependencies": {
    "@convex-dev/presence": "^0.3.0",
    "@t3-oss/env-core": "^0.13.10",
    "convex": "^1.25.4",
    "convex-helpers": "^0.1.112",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@convex-dev/eslint-plugin": "^1.1.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.5.0",
    "bun2nix": "^2.0.0",
    "convex-test": "^0.0.48",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.56.0",
    "ultracite": "^7.1.1",
    "vitest": "^4.1.4"
  }
}
