{
	"$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
	"root": false,
	"extends": ["../../biome.jsonc"],
	"files": {
		"includes": ["convex/**", "!convex/_generated", "biome.jsonc"]
	},
	"overrides": [
		{
			"includes": ["convex/**/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noEvolvingTypes": "off"
					},
					"complexity": {
						"noExcessiveCognitiveComplexity": {
							"level": "error",
							"options": {
								"maxAllowedComplexity": 25
							}
						}
					},
					"style": {
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								// "filenameCases": ["camelCase"]
							}
						}
					}
				}
			}
		}
	]
}
