{
  "name": "crm-chat-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint . && biome check && tsc -b",
    "preview": "vite preview",
    "gen:api": "openapi-typescript http://localhost:3001/openapi.json -o ./src/lib/api/schema.d.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "postinstall": "if [ -z \"$NIX_BUILD_TOP\" ]; then bun2nix -o bun.nix && nix fmt .; fi"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.59.2",
    "@convex-dev/presence": "^0.3.0",
