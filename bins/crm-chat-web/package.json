    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsqr": "^1.4.0",
    "openapi-typescript": "^7.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.8",
    "testcontainers": "^11.11.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.46.4",
    "ultracite": "^7.1.1",
    "vite": "^8.0.0",
    "zx": "^8.8.5"
  },
