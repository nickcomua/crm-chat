{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the desktop shell.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-telegram-app-credentials",
    "allow-telegram-begin-login",
    "allow-telegram-submit-code",
    "allow-telegram-submit-password",
    "allow-telegram-poll",
    "allow-telegram-load-account",
    "allow-telegram-messages",
    "allow-telegram-open-chat",
    "allow-telegram-close-chat",
    "allow-telegram-incoming",
    "allow-telegram-sponsored",
    "allow-telegram-view-sponsored",
    "allow-telegram-click-sponsored",
    "allow-telegram-logout",
    "allow-telegram-restore"
  ]
}
