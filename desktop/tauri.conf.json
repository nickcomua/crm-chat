{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "crm-chat",
  "version": "0.1.0",
  "identifier": "app.crmchat.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../web/dist",
    "beforeDevCommand": "npm --prefix web run dev -- --host 127.0.0.1 --port 4173 --strictPort",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
