{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --strict --pretty false",
    "lint:eslint": "eslint --max-warnings 0 src",
    "format": "oxfmt",
    "test": "vitest run",
    "lint": "oxlint src && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings src"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0",
    "@foldkit/ui": "0.169.0",
    "effect": "4.0.0",
    "foldkit": "0.169.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/tsgo": "0.50.0",
    "@foldkit/devtools": "0.169.0",
    "@foldkit/devtools-mcp": "0.25.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@foldkit/vite-plugin": "0.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.66.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
